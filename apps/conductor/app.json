{
  "expo": {
    "name": "Furgón — Conductor",
    "slug": "furgon-conductor",
    "scheme": "furgon-conductor",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-task-manager"
    ],
    "ios": {
      "bundleIdentifier": "cl.furgon.conductor",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "SceneDelegate"
              }
            ]
          }
        },
        "NSLocationWhenInUseUsageDescription": "Se usa para mostrar tu ruta y calcular cuánto falta para cada parada.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Se comparte SOLO mientras el recorrido está iniciado, para que los apoderados de esta ruta vean cuánto falta para que el furgón llegue."
      }
    },
    "android": {
      "package": "cl.furgon.conductor",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "extra": {
      "supabaseUrl": "https://jfjysvvrpjemcdkqutmw.supabase.co",
