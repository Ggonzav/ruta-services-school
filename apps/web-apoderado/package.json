{
  "name": "web-apoderado",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:config && esbuild src/app.ts --bundle --format=esm --target=es2020 --outfile=public/app.js",
